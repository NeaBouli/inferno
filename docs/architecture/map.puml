@startuml
title Privilege/CORS/content-trust trace
package "telegram-bot" {
  [privilege decision\nindex.js::PROTECTED_ADMIN_IDS] as priv
  [tier reader\nonChainReader.js::getSignerWallets] as tier
  [verify CORS\nmiddleware/verifyCors.js] as cors
  [verify API\nindex.js::verifyApp] as api
  [channel sync\nhandlers/channelSync.js] as sync
  [ask command\ncommands/ask.js] as ask
  [AI service\nservices/skywalker.js] as ai
  [text guard\nservices/telegramText.js] as text
}
[env config] --> priv : ADMIN_USER_IDS
[env config / Safe RPC] --> tier : SIGNER_WALLETS / getOwners()
tier --> priv : signer set (empty on failure)
[browser Origin] --> cors : origin header
cors --> api : exact allowlisted ACAO or none
[channel_post] --> sync : trusted source only
sync --> text : plain text <=4096
ask --> ai : question
ask --> text : answer
@enduml

@startuml
title Benefits seller authorization/session trace
package "benefits-network backend" {
  [config.ts + sellerAuthConfigPolicy.ts] as bcfg
  [routes/seller.ts] as sroutes
  [routes/sessions.ts] as sessroutes
  [routes/attest.ts] as attroute
  [routes/businesses.ts] as bizroutes
  [services/sellerAuth.ts] as sauth
  [services/sellerAuthorizationChallenge.ts] as schal
  [services/sessionService.ts] as sess
  [middleware/rateLimiter.ts] as rl
}
bcfg --> sauth : resolveSellerAuthContext(SELLER_AUTH_DOMAIN, CHAIN_ID)
sroutes --> schal : issueSellerAuthorizationChallenge
sroutes --> sauth : verifySellerSignature
sroutes --> schal : consumeSellerAuthorizationChallenge
sessroutes --> sauth : verifySellerSignature
sessroutes --> sess : getSession (read-only)
attroute --> sess : attest
rl --> sessroutes : sessionStatusRateLimiter
rl --> bizroutes : discoveryRateLimiter
@enduml

@startuml
