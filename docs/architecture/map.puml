[src/index.js verifyApp] --> [services/nonceStore.js] : claimNonce (atomic)
[src/index.js verifyApp] --> [services/verificationStore.js] : setVerified
[src/index.js verifyApp] --> [services/onChainReader.js] : determineTier
[src/index.js verifyApp] --> [middleware/apiRateLimit.js] : per-IP throttle (req.ip via trust proxy)
[commands/verify.js] --> [services/nonceStore.js] : createNonce
[commands/verify.js] --> [services/verificationStore.js] : unverify
[commands/verify.js] --> [middleware/rateLimit.js] : per-user throttle
[src/index.js message guard] --> [services/verificationStore.js] : getWallet/reverifyFromMap/tierHasTopicAccess
[src/index.js message guard] --> [services/onChainReader.js] : determineTier (live)
@enduml

@startuml
title Privilege/CORS/content-trust trace
package "telegram-bot" {
  [privilege decision\nindex.js::PROTECTED_ADMIN_IDS] as priv
  [tier reader\nonChainReader.js::getSignerWallets] as tier
  [verify CORS\nmiddleware/verifyCors.js] as cors
  [verify API\nindex.js::verifyApp] as api
  [channel sync\nhandlers/channelSync.js] as sync
  [ask command\ncommands/ask.js] as ask
  [AI service\nservices/skywalker.js] as ai
  [text guard\nservices/telegramText.js] as text
}
[env config] --> priv : ADMIN_USER_IDS
[env config / Safe RPC] --> tier : SIGNER_WALLETS / getOwners()
tier --> priv : signer set (empty on failure)
[browser Origin] --> cors : origin header
cors --> api : exact allowlisted ACAO or none
[channel_post] --> sync : trusted source only
sync --> text : plain text <=4096
ask --> ai : question
ask --> text : answer
@enduml
