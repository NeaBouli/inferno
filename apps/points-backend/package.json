{
  "name": "points-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx tsc",
    "start": "node dist/src/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "test": "node scripts/prepare-test-db.mjs && prisma migrate deploy && tsx src/__tests__/points.test.ts",
    "test:dependencies": "node scripts/test-dependencies.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "IFR Points Backend — SIWE auth, points events, EIP-712 voucher issuance",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "ethers": "6.17.0",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "prisma": "7.9.1",
    "siwe": "^3.0.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "path-to-regexp": "8.4.0",
    "qs": "6.15.3"
  }
}
