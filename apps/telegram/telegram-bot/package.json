{
  "name": "ifr-telegram-bot",
  "version": "1.0.0",
  "description": "Inferno ($IFR) Official Telegram Community Bot",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test test/*.test.js && npm run test:imports",
    "test:imports": "node test/import-smoke.js",
    "test:syntax": "find src test -type f -name '*.js' -exec node --check {} +"
  },
  "dependencies": {
    "axios": "1.18.1",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2",
    "express": "^5.2.1",
    "node-cache": "^5.1.2",
    "pino": "^8.18.0",
    "pino-pretty": "^13.1.3",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "IFR Protocol",
  "license": "MIT"
}
