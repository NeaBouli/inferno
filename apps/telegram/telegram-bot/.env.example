# === IFR TELEGRAM BOT — .env.example ===
# Kopiere diese Datei zu .env und befülle mit echten Werten
# .env ist in .gitignore — NIEMALS committen!

# Telegram
BOT_TOKEN=                          # Von @BotFather → /newbot

# Anthropic Claude
CLAUDE_API_KEY=                     # Bereits in Railway vorhanden — Projektleiter anfragen
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Ethereum RPC
ALCHEMY_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<YOUR_KEY>

# IFR Contracts (Mainnet)
IFR_TOKEN_ADDRESS=0x77e99917Eca8539c62F509ED1193ac36580A6e7B
IFR_LOCK_ADDRESS=                   # Aus /docs/DEPLOYMENTS.md

# Railway Proxy (für /burns — bevorzugte Quelle)
RAILWAY_API_URL=https://ifr-ai-copilot-production.up.railway.app

# Telegram Group / Channel
TELEGRAM_GROUP_ID=-1003833113414
# Trusted Quelle fuer Channel→Community Sync inkl. Auto-Pin (CWA-45):
# numerische Chat-ID oder @username des offiziellen Channels.
# Leer/unbekannt/forwarded = Sync UND Pin deaktiviert (fail closed).
TELEGRAM_CHANNEL_ID=@IFRtoken
# Forum topic routing (T-286/T-286b, src/services/topicRouter.js): every bot post to the
# group has a category -> topic. The topic IDs are FIXED CONSTANTS in code, confirmed by
# the owner on 2026-10-06 (links t.me/IFR_token/<id>). An env value is accepted only if
# it equals the category's own confirmed ID; any other value (including another
# category's ID) is ignored, the constant is used, and a warning names the variable
# (never the value). Leaving these variables empty is fine.
#   general (5): daily welcome, bootstrap countdown, verification welcome; unknown categories
#   dev/release (11): Dev/Builder posts
#   vote (23): open governance proposals (new, executable)
#   council/governance (21): governance decisions (executed, cancelled)
#   coredev (58): reserved route (admins are in the core team)
#   Roadmap (13), Locks & Assets (9): confirmed, reserved (no bot posts yet, not routable)
# NOT confirmed yet: Announcements (assumed 1) and Burns (assumed 7). Until the owner
# confirms them, both route to General (5): /announce, channel sync, bootstrap
# start/end/contributions and the daily burn report land in General. Leave their env
# variables empty (only 5 would be accepted).
# Thread 1 (Main) is never used for non-announcements. Retry only on a Telegram 400 topic
# rejection (thread not found/TOPIC_CLOSED/TOPIC_DELETED/TOPIC_ID_INVALID), once, in General.
TELEGRAM_ANNOUNCEMENTS_TOPIC_ID=
TELEGRAM_GENERAL_TOPIC_ID=5
TELEGRAM_BURNS_TOPIC_ID=
TELEGRAM_DEV_BUILDER_TOPIC_ID=11
TELEGRAM_VOTE_TOPIC_ID=23
TELEGRAM_COUNCIL_TOPIC_ID=21
TELEGRAM_COREDEV_TOPIC_ID=58

# Admin (Telegram User IDs, kommasepariert)
ADMIN_USER_IDS=                     # Telegram User ID des Projektleiters anfragen

# Etherscan (optional — Fallback für /burns)
ETHERSCAN_API_KEY=                  # Aus Projektleiter anfragen

# Rate Limiting
RATE_LIMIT_PER_MIN=5
ASK_LIMIT_PER_HOUR=3
ASK_GLOBAL_PER_HOUR=50

# Cache TTL (Sekunden)
CACHE_TTL_SECONDS=60
CACHE_TTL_BURNS=300

# Wallet Verification (3-Tier System)
VERIFY_PORT=3006                    # Express API für verify.html
VERIFY_TRUST_PROXY=172.16.0.0/12    # Trusted-Proxy-Hops für req.ip (Default: Docker-Pool, Traefik-Hop). 'none' = direkte Exposition
GNOSIS_SAFE_ADDR=0x5ad6193eD6E1e31ed10977E73e3B609AcBfEcE3b  # Treasury Safe → getOwners() auto-sync
SIGNER_WALLETS=                     # Expliziter Fallback falls Safe nicht erreichbar; leer = niemand erhaelt Signer-Tier (fail closed, CWA-38)
BUILDER_WALLETS=                    # Phase 1 Placeholder (kommasepariert)
BUILDER_REGISTRY_ADDR=              # Leer bis Phase 3 Contract deployed

# Environment
NODE_ENV=production
