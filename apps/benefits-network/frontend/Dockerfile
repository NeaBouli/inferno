FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
ARG BENEFITS_API_INTERNAL_URL=http://localhost:3001
ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_CHAIN_ID=1
ARG NEXT_PUBLIC_IFR_TOKEN_ADDRESS=0x77e99917Eca8539c62F509ED1193ac36580A6e7B
ARG NEXT_PUBLIC_IFRLOCK_ADDRESS=0x769928aBDfc949D0718d8766a1C2d7dBb63954Eb
ARG NEXT_PUBLIC_COMMITMENT_VAULT_ADDRESS=0x0719d9eb28dF7f5e63F91fAc4Bbb2d579C4F73d3
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ENV NEXT_TELEMETRY_DISABLED=1
ENV BENEFITS_API_INTERNAL_URL=${BENEFITS_API_INTERNAL_URL}
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_CHAIN_ID=${NEXT_PUBLIC_CHAIN_ID}
ENV NEXT_PUBLIC_IFR_TOKEN_ADDRESS=${NEXT_PUBLIC_IFR_TOKEN_ADDRESS}
ENV NEXT_PUBLIC_IFRLOCK_ADDRESS=${NEXT_PUBLIC_IFRLOCK_ADDRESS}
ENV NEXT_PUBLIC_COMMITMENT_VAULT_ADDRESS=${NEXT_PUBLIC_COMMITMENT_VAULT_ADDRESS}
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=${NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O- http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["node", "server.js"]
