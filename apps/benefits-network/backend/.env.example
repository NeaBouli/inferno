CHAIN_ID=11155111
# Official public hostname bound into every seller authorization message.
# Required when NODE_ENV=production (CHAIN_ID must then also be set explicitly).
SELLER_AUTH_DOMAIN=localhost
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
IFR_TOKEN_ADDRESS=0x0000000000000000000000000000000000000001
IFRLOCK_ADDRESS=0x0Cab0A9440643128540222acC6eF5028736675d3
COMMITMENT_VAULT_ADDRESS=0x0000000000000000000000000000000000000002
# Optional (ifr-benefits-verify/2): CommitmentVault V2; its TIME_ONLY tranches are added to V1 for the commitment source.
# Mainnet: 0x8efae0C85ad6d44C731cAEDA1cBC275904Fc7c8F
COMMITMENT_VAULT_V2_ADDRESS=
PARTNER_VAULT_ADDRESS=
BUILDER_REGISTRY_ADDRESS=
# Optional read-only eligibility check. Never put a private key in this service.
REWARD_CALLER_ADDRESS=
# Lane 4 Model B settlement export (T-275). Default-off; leave empty until a pilot is approved.
# Must not be combined with REWARD_CALLER_ADDRESS. The policy JSON holds no secrets.
MODEL_B_SETTLEMENT_ENABLED=
MODEL_B_PILOT_POLICY_JSON=
ADMIN_SECRET=replace-with-a-long-random-admin-secret
# T-231a: server-side HMAC key for customer wallet fingerprints (>= 32 chars, different from
# ADMIN_SECRET, never logged). Customer wallet addresses are never stored; without this key customer
# checkout, passes and history refuse with 503. Changing it orphans every stored fingerprint.
CUSTOMER_WALLET_HMAC_KEY=
DATABASE_URL=file:./dev.db
PORT=3001
# Maximum number of active seller profiles per wallet.
MAX_ACTIVE_SELLER_BUSINESSES_PER_WALLET=5
# Lifetime cap of persisted seller profiles per wallet (including deactivated).
# Must be greater than or equal to the active-profile cap above.
MAX_TOTAL_SELLER_BUSINESSES_PER_WALLET=25
