{
  "name": "ifr-benefits-network-backend",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:typecheck && DATABASE_URL=file:./test.db node scripts/reset-test-db.cjs && DATABASE_URL=file:./test.db vitest run",
    "test:model-b-tools": "node --test scripts/model-b-tools.test.cjs",
    "test:ethers-v6-lifecycle": "npm run test:typecheck && DATABASE_URL=file:./test.db vitest run tests/ethersV6Services.test.ts",
    "test:rate-limit-startup": "node scripts/test-rate-limit-startup.cjs",
    "test:migration-upgrade": "node scripts/verify-populated-migration-upgrade.cjs && node scripts/verify-owner-b-migration.cjs",
    "retention:report": "npm run build --silent && node dist/retentionCli.js report",
    "retention:prune": "npm run build --silent && node dist/retentionCli.js apply",
    "smoke:http": "bash scripts/ci-http-smoke.sh",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.17.0",
    "express": "4.22.3",
    "express-rate-limit": "^7.1.5",
    "prisma": "^5.10.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "brace-expansion": "5.0.12",
    "ws": "8.21.0"
  }
}
