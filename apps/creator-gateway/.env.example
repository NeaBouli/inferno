PORT=3005
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# CHAIN_ID and IFRLOCK_ADDRESS must be set together; unset they default
# as a pair to Sepolia (11155111 + address below). Never set just one.
IFRLOCK_ADDRESS=0x0Cab0A9440643128540222acC6eF5028736675d3
CHAIN_ID=11155111
# Required, no default — startup fails without them.
JWT_SECRET=replace-with-long-random-secret
# Exact SIWE binding values of the deployment origin (no fallback).
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:3005
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback
# NODE_ENV=production enables the Secure flag on the OAuth initiator cookie.
YOUTUBE_CHANNEL_ID=UCyour-channel-id
MIN_LOCK_IFR=1000
